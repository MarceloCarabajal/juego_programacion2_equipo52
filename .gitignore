# =============================
#   PROYECTO C++ + SFML + VSCode
# =============================

# --- VSCode ---
.vscode/
*.code-workspace

# --- Compilación GCC/Clang ---
*.o
*.obj
*.a
*.out
*.exe
*.dll
*.pdb
*.lib
*.so
*.dylib

# --- Carpeta output del juego ---
juego/output/

# --- Build directories ---
/bin/
/build/
/dist/
/Debug/
/Release/
/x64/
/x86/
juego/Debug/
juego/x64/
juego/Release/
/*.log

# --- Archivos generados por Visual Studio (si abrís el proyecto ahí) ---
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# --- Archivos temporales ---
*.tmp
*.temp
*.cache
*.log
*.db
*.dat

# --- Archivos del sistema ---
.DS_Store
Thumbs.db

# --- SFML local (no queremos subir librerías) ---
/SFML/*
/packages/
*.dll
*.pdb

# --- Excluimos sprites masivos, PERO preservamos los que sí queremos subir ---
# (cuidado: deja subir solo los de enemigo)
recursos/sprites/*
!recursos/sprites/enemigo/
!recursos/sprites/enemigo/8 idle.png
!recursos/sprites/enemigo/8 walk.png
recursos/background/

# --- Fuentes ---
*.ttf
/*.otf

# --- Audio ---
*.wav
*.ogg
*.mp3

# --- Ejecutables del juego ---
/juego.exe

# --- Archivos de backup ---
*~
*.bak
*.old
*.orig
